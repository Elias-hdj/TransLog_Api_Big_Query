# ============================================
# TransLog - Variables d'environnement
# ============================================
# Ce fichier est un MODELE. Ne mets JAMAIS de vraie clé ici.
# Copie ce fichier en .env et remplis les valeurs réelles en local.

# --- Google Cloud Platform ---
GCP_PROJECT_ID=translog-gcp
GCP_SA_KEY_B64=cle_service_account_encodee_en_base64

# --- APIs (si besoin d'ajouter des clés plus tard) ---
# FUEL_API_URL=https://data.economie.gouv.fr/api/explore/v2.1/catalog/datasets/prix-des-carburants-en-france-flux-instantane-v2/records
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# --- Environnement ---
ENV=dev
LOG_LEVEL=INFO